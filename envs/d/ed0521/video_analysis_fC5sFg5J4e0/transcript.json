{
  "language": "zh",
  "language_probability": 1,
  "segments": [
    {
      "start": 12.5,
      "end": 15.02,
      "text": "这次运动会大家表现得很棒"
    },
    {
      "start": 15.02,
      "end": 16.86,
      "text": "虽然没有名次"
    },
    {
      "start": 16.86,
      "end": 18.94,
      "text": "但是大家都尽力了"
    },
    {
      "start": 18.94,
      "end": 20.78,
      "text": "同学们不要气馁"
    },
    {
      "start": 20.78,
      "end": 23.1,
      "text": "下次的活动再好好表现"
    },
    {
      "start": 23.1,
      "end": 24.18,
      "text": "给自己一个掌声"
    },
    {
      "start": 28.1,
      "end": 28.82,
      "text": "小文"
    },
    {
      "start": 28.82,
      "end": 30.3,
      "text": "要不是你跌倒调棒"
    },
    {
      "start": 30.3,
      "end": 32.18,
      "text": "我们班早就队一名了"
    },
    {
      "start": 32.18,
      "end": 33.86,
      "text": "都是你爱的"
    },
    {
      "start": 33.86,
      "end": 34.74,
      "text": "阿强"
    },
    {
      "start": 34.74,
      "end": 37.06,
      "text": "小文也不是故意要跌倒的啊"
    },
    {
      "start": 37.06,
      "end": 39.78,
      "text": "身为同学大家要互相鼓励"
    },
    {
      "start": 39.78,
      "end": 40.9,
      "text": "不可以这么凶"
    },
    {
      "start": 43.5,
      "end": 46.5,
      "text": "我跟你们说"
    },
    {
      "start": 46.5,
      "end": 50.5,
      "text": "我们等等把小文的东西藏起来"
    },
    {
      "start": 50.5,
      "end": 51.5,
      "text": "让他找不到"
    },
    {
      "start": 51.5,
      "end": 53.5,
      "text": "好啊 感觉很好玩"
    },
    {
      "start": 58.5,
      "end": 61.5,
      "text": "阿强 你们不能这样欠负小文"
    },
    {
      "start": 61.5,
      "end": 64.5,
      "text": "老师说过这种恶作绝是不对的"
    },
    {
      "start": 64.5,
      "end": 66.5,
      "text": "要你管"
    },
    {
      "start": 66.5,
      "end": 67.5,
      "text": "阿梅我告诉你"
    },
    {
      "start": 67.5,
      "end": 69.5,
      "text": "如果你敢说出去你就惨了"
    },
    {
      "start": 70.5,
      "end": 86.83,
      "text": "接下来就"
    },
    {
      "start": 87.83,
      "end": 88.83,
      "text": "好好玩"
    },
    {
      "start": 97.77,
      "end": 98.77,
      "text": "新闻"
    },
    {
      "start": 98.77,
      "end": 100.77,
      "text": "好大声啊"
    },
    {
      "start": 100.77,
      "end": 101.77,
      "text": "这样"
    },
    {
      "start": 101.77,
      "end": 105.46,
      "text": "如果看到同学被欺负"
    },
    {
      "start": 105.46,
      "end": 107.46,
      "text": "记得要来跟老师说"
    },
    {
      "start": 109.46,
      "end": 111.46,
      "text": "我要去告诉老师"
    },
    {
      "start": 111.46,
      "end": 117.3,
      "text": "对周子怎么变这样"
    },
    {
      "start": 117.3,
      "end": 123.24,
      "text": "阿梅 怎么了"
    },
    {
      "start": 123.24,
      "end": 124.24,
      "text": "老师老师"
    },
    {
      "start": 124.24,
      "end": 127.24,
      "text": "阿强他们一直欺负小文"
    },
    {
      "start": 127.24,
      "end": 128.24,
      "text": "我是在看不下去"
    },
    {
      "start": 128.24,
      "end": 130.24,
      "text": "所以来跟老师报告"
    },
    {
      "start": 130.24,
      "end": 132.24,
      "text": "阿梅 你的做法是正确的"
    },
    {
      "start": 132.24,
      "end": 134.24,
      "text": "他们已经不是第一次了"
    },
    {
      "start": 134.24,
      "end": 137.24,
      "text": "老师这就去请学务处协助处理"
    },
    {
      "start": 137.24,
      "end": 142.38,
      "text": "你们三个为什么一直欺负小文"
    },
    {
      "start": 142.38,
      "end": 145.38,
      "text": "我们 我们只是跟小文玩而已"
    },
    {
      "start": 145.38,
      "end": 146.38,
      "text": "而且"
    },
    {
      "start": 146.38,
      "end": 148.38,
      "text": "他又没有说他不喜欢"
    },
    {
      "start": 148.38,
      "end": 150.38,
      "text": "对啊 只是好玩而已"
    },
    {
      "start": 150.38,
      "end": 152.38,
      "text": "虽说小文没有说出口"
    },
    {
      "start": 152.38,
      "end": 154.38,
      "text": "但欺负同学就是不对的"
    },
    {
      "start": 154.38,
      "end": 155.38,
      "text": "你们有没有想过"
    },
    {
      "start": 155.38,
      "end": 157.38,
      "text": "这些你自己认为好玩的事"
    },
    {
      "start": 157.38,
      "end": 159.38,
      "text": "很有可能会伤害到对方呢"
    },
    {
      "start": 159.38,
      "end": 161.38,
      "text": "比赛输了虽然可惜"
    },
    {
      "start": 161.38,
      "end": 162.38,
      "text": "但生气时"
    },
    {
      "start": 162.38,
      "end": 164.38,
      "text": "不该用暴力或破坏东西"
    },
    {
      "start": 164.38,
      "end": 166.38,
      "text": "来发泄自己的情绪"
    },
    {
      "start": 166.38,
      "end": 168.38,
      "text": "阿强 今天换作是你"
    },
    {
      "start": 168.38,
      "end": 170.38,
      "text": "你希望被这样对待吗"
    },
    {
      "start": 172.38,
      "end": 173.38,
      "text": "你们欺负小文的行情"
    },
    {
      "start": 173.38,
      "end": 175.38,
      "text": "可能会构成霸凌行为"
    },
    {
      "start": 175.38,
      "end": 176.38,
      "text": "为了请替你们"
    },
    {
      "start": 176.38,
      "end": 178.38,
      "text": "老师会安排校园服务"
    },
    {
      "start": 178.38,
      "end": 180.38,
      "text": "如果再不好好反省"
    },
    {
      "start": 180.38,
      "end": 182.38,
      "text": "继续有欺负同学的事情"
    },
    {
      "start": 182.38,
      "end": 183.38,
      "text": "学校就会启动"
    },
    {
      "start": 183.38,
      "end": 185.38,
      "text": "霸凌事件程序来处理"
    },
    {
      "start": 186.38,
      "end": 192.92,
      "text": "大家对不起"
    },
    {
      "start": 192.92,
      "end": 194.92,
      "text": "因为我让大家"
    },
    {
      "start": 194.92,
      "end": 196.92,
      "text": "没办法拿第一名"
    },
    {
      "start": 196.92,
      "end": 198.92,
      "text": "我很抱歉"
    },
    {
      "start": 199.92,
      "end": 200.92,
      "text": "小文 没关系啦"
    },
    {
      "start": 200.92,
      "end": 201.92,
      "text": "我们Carry你"
    },
    {
      "start": 201.92,
      "end": 203.92,
      "text": "下次再一起加油"
    },
    {
      "start": 203.92,
      "end": 204.92,
      "text": "这次就算了"
    },
    {
      "start": 204.92,
      "end": 206.92,
      "text": "我下次再教你跑了"
    },
    {
      "start": 207.92,
      "end": 209.92,
      "text": "下次我们一定得你"
    },
    {
      "start": 210.92,
      "end": 211.92,
      "text": "谢谢大家"
    },
    {
      "start": 211.92,
      "end": 213.92,
      "text": "我会努力的"
    },
    {
      "start": 213.92,
      "end": 215.92,
      "text": "班上的同学都是一体的"
    },
    {
      "start": 215.92,
      "end": 216.92,
      "text": "同学之间"
    },
    {
      "start": 216.92,
      "end": 218.92,
      "text": "应该要彼此尊重与包容"
    },
    {
      "start": 218.92,
      "end": 220.92,
      "text": "更要互相关心关怀"
    },
    {
      "start": 220.92,
      "end": 221.92,
      "text": "互相照顾"
    },
    {
      "start": 223.92,
      "end": 224.92,
      "text": "遭遇霸凌时"
    },
    {
      "start": 224.92,
      "end": 226.92,
      "text": "一定要勇敢说出来"
    },
    {
      "start": 226.92,
      "end": 227.92,
      "text": "你可以"
    },
    {
      "start": 228.92,
      "end": 231.92,
      "text": "向老师 家长 及好朋友反应"
    },
    {
      "start": 231.92,
      "end": 234.92,
      "text": "写信给学校投诉信箱"
    },
    {
      "start": 235.92,
      "end": 238.92,
      "text": "在校园生活问卷中提出"
    },
    {
      "start": 238.92,
      "end": 240.92,
      "text": "拨打个信是"
    },
    {
      "start": 240.92,
      "end": 242.92,
      "text": "防治校园霸凌专线"
    },
    {
      "start": 243.92,
      "end": 246.92,
      "text": "教育部防治校园霸凌专区留言"
    },
    {
      "start": 246.92,
      "end": 250.92,
      "text": "拨打防治校园霸凌专线1953"
    },
    {
      "start": 250.92,
      "end": 255.3,
      "text": "我会尊重 关心 爱与关怀"
    },
    {
      "start": 255.3,
      "end": 257.3,
      "text": "自己和他人"
    },
    {
      "start": 257.3,
      "end": 260.3,
      "text": "所以 我拒绝霸凌"
    }
  ]
}